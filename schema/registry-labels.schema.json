{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue label registry",
  "description": "Every dispatched issue carries exactly one task-kind label and exactly one profile label.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_kinds",
    "profiles"
  ],
  "properties": {
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/label"
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    }
  }
}
