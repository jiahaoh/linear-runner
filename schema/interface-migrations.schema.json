{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runner-project interface migrations",
  "description": "One entry per interface bump, from the version before it; validate-config prints the steps for every entry between a declared and the current interface.",
  "type": "object",
  "additionalProperties": false,
  "required": ["migrations"],
  "properties": {
    "notes": {"type": "array", "items": {"type": "string"}},
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "release", "changes", "steps"],
        "properties": {
          "from": {"type": "integer", "minimum": 1},
          "to": {"type": "integer", "minimum": 2},
          "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
