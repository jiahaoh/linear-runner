{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site layer (private): host bindings",
  "description": "Executables, storage roots and the host model catalog for one execution host. Executables and variables become ${name} substitutions in project and batch paths, checks and environment values. The optional launcher object configures how `launch` starts the host supervisor. The optional attention object holds DRAFT notifier, watchdog, draft-lint and outbox settings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executables",
    "state_root",
    "artifact_root",
    "model_catalog"
  ],
  "properties": {
    "executables": {
      "type": "object",
      "required": [
        "codex"
      ],
      "propertyNames": {
        "$ref": "#/$defs/variable"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/variable"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "state_root": {
      "$ref": "#/$defs/text"
    },
    "artifact_root": {
      "$ref": "#/$defs/text"
    },
    "model_catalog": {
      "$ref": "#/$defs/text"
    },
    "launcher": {
      "description": "Host supervisor launch settings used by `runner.py launch`; outside the configuration fingerprint and recorded in each launch record.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "systemd-user",
            "foreground"
          ]
        },
        "python": {
          "$ref": "#/$defs/text"
        },
        "cpu_list": {
          "$ref": "#/$defs/text"
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/variable"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "unit_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "startup_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "stop_on_exit": {
          "type": "boolean"
        }
      }
    },
    "attention": {
      "description": "DRAFT settings for telling a person about progress and stops; outside the configuration fingerprint.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": {
              "enum": [
                "none",
                "command",
                "linear-mention-only"
              ]
            },
            "command": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "watchdog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stall_minutes": {
              "type": "integer",
              "minimum": 5
            }
          }
        },
        "lint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_chars": {
              "type": "integer",
              "minimum": 200
            },
            "max_lines": {
              "type": "integer",
              "minimum": 5
            },
            "max_first_sentence_chars": {
              "type": "integer",
              "minimum": 40
            }
          }
        },
        "outbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "poll_seconds": {
              "type": "number",
              "minimum": 0
            },
            "settle_seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    }
  }
}
