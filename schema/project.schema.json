{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project layer (private): one repository and Linear project",
  "description": "Stored as projects/<name>.json. The Linear project is referenced by exact name and resolved to an ID at dry-run/preflight.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "linear_project", "repo", "artifact_owner", "retention", "guidance_files", "checks"],
  "properties": {
    "workspace": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "linear_project": {"$ref": "#/$defs/text"},
    "repo": {"$ref": "#/$defs/text"},
    "artifact_owner": {"$ref": "#/$defs/text"},
    "retention": {"$ref": "#/$defs/text"},
    "backup_status": {"$ref": "#/$defs/text"},
    "guidance_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "context_files": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "contract_file": {"$ref": "#/$defs/text", "description": "Shared contract every issue follows; the intake references it by path and SHA-256 instead of inlining it."},
    "intake_mode": {"enum": ["compact", "full"], "description": "compact (default): issue-specific intake with file references; full: the schema-1 packet with every context file inlined."},
    "identity_files": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "check_environment": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "delivery_checks": {"type": "array", "items": {"$ref": "#/$defs/delivery"}},
    "delivery_integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "tier", "inputs", "cwd", "command"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["code", "docs", "presentation", "always"]},
        "tier": {"enum": ["default", "extended"]},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "cwd": {"$ref": "#/$defs/text"},
        "command": {"$ref": "#/$defs/argv"}
      }
    },
    "relpath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$"},
    "integrity": {
      "description": "Post-delivery integrity step (no model). manifest is relative to the issue's delivery directory; file_hashes values and true_fields files are relative to the manifest's directory.",
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "revision_field"],
      "properties": {
        "required_checks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "manifest": {"$ref": "#/$defs/relpath"},
        "revision_field": {"$ref": "#/$defs/text"},
        "file_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/relpath"}},
        "true_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "field"],
            "properties": {"file": {"$ref": "#/$defs/relpath"}, "field": {"$ref": "#/$defs/text"}}
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd", "command"],
      "properties": {
        "cwd": {"$ref": "#/$defs/text"},
        "command": {"$ref": "#/$defs/argv"}
      }
    }
  }
}
