{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Batch layer (private): one authorized issue queue",
  "description": "Names the project, the ordered issue allowlist, gates and the dedicated branch. Policy comes from the registry, not the batch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "issues", "terminal_issue", "branch"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "project": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "issues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/issue"}},
    "terminal_issue": {"$ref": "#/$defs/issue"},
    "branch": {"$ref": "#/$defs/text"},
    "worktree": {"$ref": "#/$defs/text"},
    "guidance_files": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "required_done": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/issue"}},
    "supervision": {
      "description": "DRAFT: generic supervisor behavior for this queue.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop_after": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/issue"}},
        "on_block": {"enum": ["stop", "continue_independent"]},
        "report_issues": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/issue"}},
        "decision_rules": {"enum": ["honor", "ignore"]},
        "baseline_checks": {"type": "boolean"}
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "comment_id", "author_id", "approval_text"],
        "properties": {
          "issue_id": {"$ref": "#/$defs/issue"},
          "comment_id": {"$ref": "#/$defs/text"},
          "author_id": {"$ref": "#/$defs/text"},
          "approval_text": {"$ref": "#/$defs/text"}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "issue": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
