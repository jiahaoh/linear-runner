{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Batch layer (private): one authorized issue queue",
  "description": "Names the project, the ordered issue allowlist, gates and the dedicated branch. Policy comes from the registry, not the batch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project",
    "issues",
    "terminal_issue",
    "branch"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "terminal_issue": {
      "$ref": "#/$defs/issue"
    },
    "branch": {
      "$ref": "#/$defs/text"
    },
    "worktree": {
      "$ref": "#/$defs/text"
    },
    "interface_version": {
      "description": "The runner-project interface this batch file was written for (registry/interface.json); validate-config refuses an older one with the migration steps.",
      "type": "integer",
      "minimum": 1
    },
    "runner_version": {
      "description": "Pin the runner release (for example 2.0.0): launch preflight refuses a runner checkout that is not the clean, tagged release v<runner_version>.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "variables": {
      "description": "Values for site variables (site.json variables) that apply to this batch only, for example another Python environment. Each name must be a site variable; executables and the built-ins (home, runner_root, batch, worktree) cannot be overridden. Part of the fingerprinted batch configuration.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/variable"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "guidance_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "required_done": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "supervision": {
      "description": "Supervisor behavior for this queue: planned checkpoints, blocking policy, extra report destinations, decision rules and baseline checks.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop_after": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "on_block": {
          "description": "Issue-level block without a matching rule: stop (default) pauses the batch; continue_independent defers the issue and continues with independent issues.",
          "enum": [
            "stop",
            "continue_independent"
          ]
        },
        "report_issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "decision_rules": {
          "enum": [
            "honor",
            "ignore"
          ]
        },
        "baseline_checks": {
          "type": "boolean"
        }
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "comment_id",
          "author_id",
          "approval_text"
        ],
        "properties": {
          "issue_id": {
            "$ref": "#/$defs/issue"
          },
          "comment_id": {
            "$ref": "#/$defs/text"
          },
          "author_id": {
            "$ref": "#/$defs/text"
          },
          "approval_text": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "context_controls": {
      "description": "Per-batch opt-in context-cost controls (all off by default); part of the pinned, fingerprinted batch configuration.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bounded_sessions": {
          "description": "Continue long worker sessions in a fresh session from a handoff (thresholds in registry phases.bounded_sessions).",
          "type": "boolean"
        },
        "low_risk_review": {
          "description": "Allow the lighter review of registry profiles.review_routing.light_review for low-risk issues.",
          "type": "boolean"
        },
        "compact_token_limit": {
          "description": "Auto-compaction threshold in tokens for every model phase (overrides the registry phase value); null leaves the CLI default. Only backends that support it (Codex) may serve a phase with a limit; otherwise the configuration is rejected.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1000
        }
      }
    },
    "model_overrides": {
      "description": "Pool entries named by the batch, per phase: <model> or <model>@<effort>. Batch-wide values apply to every issue; issues.<id> values win over them, and both win over issue labels. Each must be in that phase's pool for the issue (registry pools); preflight fails otherwise.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implement": {
          "type": "string",
          "pattern": "^[^\\s@]+(@[^\\s@]+)?$"
        },
        "repair": {
          "type": "string",
          "pattern": "^[^\\s@]+(@[^\\s@]+)?$"
        },
        "review": {
          "type": "string",
          "pattern": "^[^\\s@]+(@[^\\s@]+)?$"
        },
        "issues": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/issue"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "implement": {
                "type": "string",
                "pattern": "^[^\\s@]+(@[^\\s@]+)?$"
              },
              "repair": {
                "type": "string",
                "pattern": "^[^\\s@]+(@[^\\s@]+)?$"
              },
              "review": {
                "type": "string",
                "pattern": "^[^\\s@]+(@[^\\s@]+)?$"
              }
            }
          }
        }
      }
    },
    "phase_overrides": {
      "description": "Per-issue phase limits for this batch: {\"<issue>\": {\"<phase>\": {\"timeout_seconds\": N}}}. N may exceed the registry phase timeout up to registry phases.max_timeout_seconds.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/issue"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "implement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeout_seconds"
            ],
            "properties": {
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "repair": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeout_seconds"
            ],
            "properties": {
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeout_seconds"
            ],
            "properties": {
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    }
  }
}
