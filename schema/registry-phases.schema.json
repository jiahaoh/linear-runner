{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase budget and limit registry",
  "description": "Soft per-phase usage budgets, model-call timeouts, the shared repair limit and the per-check timeout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phases",
    "max_repairs",
    "check_timeout_seconds"
  ],
  "properties": {
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implement",
        "repair",
        "review"
      ],
      "properties": {
        "implement": {
          "$ref": "#/$defs/phase"
        },
        "repair": {
          "$ref": "#/$defs/phase"
        },
        "review": {
          "$ref": "#/$defs/phase"
        }
      }
    },
    "max_repairs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "check_timeout_seconds": {
      "$ref": "#/$defs/positive"
    },
    "bounded_sessions": {
      "description": "Opt-in: continue worker phases in a fresh Codex session seeded with a handoff file instead of resuming a long session.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "input_threshold_tokens",
        "handoff_after_implement",
        "max_handoff_bytes"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "input_threshold_tokens": {
          "$ref": "#/$defs/positive"
        },
        "handoff_after_implement": {
          "type": "boolean"
        },
        "max_handoff_bytes": {
          "$ref": "#/$defs/positive"
        }
      }
    }
  },
  "$defs": {
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget",
        "timeout_seconds"
      ],
      "properties": {
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "tool_calls"
          ],
          "properties": {
            "input_tokens": {
              "$ref": "#/$defs/positive"
            },
            "output_tokens": {
              "$ref": "#/$defs/positive"
            },
            "tool_calls": {
              "$ref": "#/$defs/positive"
            }
          }
        },
        "timeout_seconds": {
          "$ref": "#/$defs/positive"
        }
      }
    }
  }
}
