{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model and reasoning-effort registry",
  "description": "Models that policy may select, the backend CLI that runs each and the reasoning efforts each may use. Dispatch still checks the backend's host catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "efforts",
    "models"
  ],
  "properties": {
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "efforts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backend",
          "efforts"
        ],
        "properties": {
          "backend": {
            "enum": [
              "codex",
              "claude"
            ]
          },
          "efforts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^\\S+$"
    }
  }
}
