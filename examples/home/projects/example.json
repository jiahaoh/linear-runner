{
  "interface_version": 1,
  "workspace": "example",
  "linear_project": "Example project",
  "repo": "/absolute/path/to/repository",
  "artifact_owner": "REPLACE_OWNER",
  "retention": "REPLACE_RETENTION_POLICY",
  "backup_status": "unverified",
  "guidance_files": [
    "${runner_root}/prompts/generic.md"
  ],
  "context_files": [],
  "criterion_lint": [
    {
      "pattern": "complete (test )?suite",
      "unless": "as the batch guidance defines it",
      "message": "name the selections that make up the suite, or say \"as the batch guidance defines it\"; a review reads \"complete\" literally"
    },
    {
      "pattern": "(unchanged|equal to the base revision)",
      "message": "say what produces the comparison with the base revision (a base_parity check or a named script); a test that only compares the current tree is not that evidence"
    }
  ],
  "contract_file": "../contracts/shared-contract.md",
  "identity_files": [],
  "check_environment": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "TMPDIR": "${scratch}/${batch}"
  },
  "checks": [
    {
      "name": "regression",
      "kind": "code",
      "tier": "default",
      "inputs": [
        "**/*.py",
        "pyproject.toml",
        "uv.lock"
      ],
      "cwd": ".",
      "command": [
        "${python}",
        "-m",
        "unittest",
        "discover",
        "-v"
      ]
    }
  ],
  "delivery_checks": []
}
