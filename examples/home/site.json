{
  "executables": {
    "codex": "codex",
    "python": "python3",
    "uv": "uv"
  },
  "variables": {
    "scratch": "/absolute/path/to/local/scratch"
  },
  "state_root": "/absolute/path/to/external-runs/controller",
  "artifact_root": "/absolute/path/to/external-runs/issues",
  "model_catalog": "~/.codex/models_cache.json",
  "launcher": {
    "backend": "systemd-user",
    "python": "${python}",
    "cpu_list": "0",
    "environment": {
      "PATH": "/absolute/path/to/bin:/usr/bin:/bin"
    },
    "unit_prefix": "linear-runner",
    "startup_timeout_seconds": 30,
    "stop_on_exit": true
  },
  "attention": {
    "command_prefix": "python3 ${runner_root}/runner.py",
    "notifier": {
      "backend": "none",
      "command": [],
      "timeout_seconds": 30
    },
    "watchdog": {
      "stall_minutes": 120,
      "interval_minutes": 10
    },
    "lint": {
      "max_chars": 1500,
      "max_lines": 30,
      "max_first_sentence_chars": 240
    },
    "outbox": {
      "poll_seconds": 15,
      "settle_seconds": 3
    }
  }
}
